{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "app.js",
    "src/**/*.ts",
    "tests/**/*.js",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "playwright.config.js",
    "vitest.config.ts"
  ]
}
